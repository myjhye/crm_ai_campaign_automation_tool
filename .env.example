APP_NAME="CRM AI Campaign Automation API"
ENVIRONMENT=development
# JSON array of allowed frontend origins. Empty by default.
CORS_ORIGINS=[]
POSTGRES_USER=growthpilot
POSTGRES_DB=growthpilot
POSTGRES_PORT=5432
# Choose a local password and use its URL-encoded value in DATABASE_URL.
POSTGRES_PASSWORD=replace_with_local_password
DATABASE_URL=postgresql+psycopg://growthpilot:replace_with_local_password@127.0.0.1:5432/growthpilot
WORKER_LEASE_SECONDS=30
WORKER_HEARTBEAT_SECONDS=10
WORKER_POLL_SECONDS=1
AI_MODE=mock
AI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
AI_TIMEOUT_SECONDS=20
AI_MAX_OUTPUT_TOKENS=2000
